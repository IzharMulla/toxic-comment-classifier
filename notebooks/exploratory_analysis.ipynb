 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Toxic Comment Classification - Exploratory Data Analysis\n",
    "\n",
    "This notebook provides exploratory analysis on the Kaggle Jigsaw Toxic Comment Classification dataset for multi-label classification.\n",
    "\n",
    "## Objectives:\n",
    "1. Inspect dataset structure and validate target label columns.\n",
    "2. Analyze class imbalance and label distribution across toxicity categories.\n",
    "3. Investigate label correlations (co-occurrence of toxicity types).\n",
    "4. Analyze comment text length distributions.\n",
    "5. Evaluate feature extraction strategies using TF-IDF."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from ml.preprocessing import clean_text\n",
    "\n",
    "# Set plot style\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "TARGET_COLUMNS = ['toxic', 'severe_toxic', 'obscene', 'threat', 'insult', 'identity_hate']"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Dataset & Preview"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data_path = os.path.join('..', 'data', 'train.csv')\n",
    "if not os.path.exists(data_path):\n",
    "    data_path = os.path.join('data', 'train.csv')\n",
    "\n",
    "df = pd.read_csv(data_path)\n",
    "print(f\"Dataset Shape: {df.shape}\")
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Target Label Distribution (Class Imbalance)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "label_counts = df[TARGET_COLUMNS].sum().sort_values(ascending=False)\n",
    "plt.figure(figsize=(10, 5))\n",
    "sns.barplot(x=label_counts.index, y=label_counts.values, palette='magma')\n",
    "plt.title('Toxicity Class Counts', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Category')\n",
    "plt.ylabel('Frequency')\n",
    "plt.show()\n",
    "\n",
    "print(\"Class percentages:\")\n",
    "print((label_counts / len(df)) * 100)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Label Co-occurrence & Correlation Heatmap"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(df[TARGET_COLUMNS].corr(), annot=True, fmt='.2f', cmap='coolwarm', vmin=-1, vmax=1)\n",
    "plt.title('Label Co-occurrence Correlation Matrix', fontsize=14, fontweight='bold')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Text Length Distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df['char_length'] = df['comment_text'].apply(len)\n",
    "df['word_count'] = df['comment_text'].apply(lambda x: len(str(x).split()))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "sns.histplot(df['char_length'], bins=50, kde=True, ax=axes[0], color='crimson')\n",
    "axes[0].set_title('Character Length Distribution')\n",
    "axes[0].set_xlim(0, 2000)\n",
    "\n",
    "sns.histplot(df['word_count'], bins=50, kde=True, ax=axes[1], color='indigo')\n",
    "axes[1].set_title('Word Count Distribution')\n",
    "axes[1].set_xlim(0, 400)\n",
    "plt.show()"
   ]
  }
 ],
